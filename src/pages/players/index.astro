---
import Layout from '../../layouts/Layout.astro';
import Avatar from '../../components/Avatar.astro';
import TeamChip from '../../components/TeamChip.astro';
import { playerHref } from '../../lib/url.ts';
import { allPlayers, playerAgg } from '../../lib/stats.ts';
import { rows, playerLatestTeam } from '../../lib/site-data.ts';

const players = allPlayers(rows)
  .map((name) => {
    const agg = playerAgg(name, rows); // all-time, fill-ins excluded
    return { name, agg, team: playerLatestTeam(name) };
  })
  .filter((p) => p.agg.games > 0)
  .sort((a, b) => b.agg.games - a.agg.games || a.name.localeCompare(b.name));
---
<Layout title="Players">
  <section class="section container">
    <p class="eyebrow">The Field</p>
    <h1 class="serif-title">Players</h1>
    <p class="lead" style="max-width:620px">
      Every competitor to have logged a stat line. Fill-in appearances are
      excluded from these headline numbers.
    </p>

    <div class="grid grid-auto mt-24">
      {players.map((p) => (
        <a class="card player-card" href={playerHref(p.agg.slug)}>
          <div class="player-avatar"><Avatar slug={p.agg.slug} name={p.name} team={p.team} /></div>
          <div class="player-meta">
            <h3 class="player-name serif-title">{p.name}</h3>
            <TeamChip team={p.team} plain />
            <div class="player-line muted">
              {p.agg.games} matches · {p.agg.wins}W–{p.agg.losses}L · {(p.agg.winPct * 100).toFixed(0)}%
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .player-card {
    display: grid; grid-template-columns: 64px 1fr; gap: 14px; align-items: center;
    transition: transform .15s ease, border-color .15s ease;
  }
  .player-card:hover { transform: translateY(-3px); border-color: var(--gold); text-decoration: none; }
  .player-avatar { width: 64px; }
  .player-name { font-size: 1.2rem; margin: 0 0 6px; }
  .player-line { font-size: 0.82rem; margin-top: 6px; font-variant-numeric: tabular-nums; }
</style>
