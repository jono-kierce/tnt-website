---
import Layout from '../../layouts/Layout.astro';
import Avatar from '../../components/Avatar.astro';
import TeamChip from '../../components/TeamChip.astro';
import VotesNote from '../../components/VotesNote.astro';
import StatSummary from '../../components/StatSummary.astro';
import TrendChart from '../../components/TrendChart.astro';
import OpponentTile from '../../components/OpponentTile.astro';
import SetScore from '../../components/SetScore.astro';
import { SITE, seasonLabel, teamMeta, isVotesSealed } from '../../config/site.ts';
import { withBase } from '../../lib/url.ts';
import { allPlayers, bestWorstOpponent, fillInRecord, fillInVotes, playerAgg, playerRows, playerTrend } from '../../lib/stats.ts';
import { playerRanks } from '../../lib/ranks.ts';
import { rows, playerLatestTeam, playerSeasons } from '../../lib/site-data.ts';
import { bioHtml, playerPhotos } from '../../lib/content.ts';

export function getStaticPaths() {
  return allPlayers(rows).map((name) => ({
    params: { player: playerAgg(name, rows).slug },
    props: { name },
  }));
}

const { name } = Astro.props;
const team = playerLatestTeam(name);
const accent = teamMeta(team);
const seasons = playerSeasons(name);
const slug = playerAgg(name, rows).slug;

// All-time + per season. Three aggregates per scope: everything including
// finals (rates), the
// home-and-away season on its own (raw totals and the season record, as on the
// leaderboards) and finals on their own (the September record, Finals MVP).
// Each scope also carries the player's standing in that same window, so a badge
// on a season panel ranks the season, not the career.
// Fill-ins count career-wide — you still turned up and played — but not inside
// a season, where they were played for another team. A season panel that drops
// them says so, and shows what it dropped.
const allTime = playerAgg(name, rows, { includeFillIns: true });
const scopes = [
  { key: 'all', short: 'all-time', season: undefined as number | undefined },
  ...seasons.map((s) => ({ key: String(s), short: `in S${s}`, season: s as number | undefined })),
].map((sc) => {
  const includeFillIns = sc.season === undefined;
  const regular = playerAgg(name, rows, { season: sc.season, includeFillIns, scope: 'regular' });
  const finals = playerAgg(name, rows, { season: sc.season, includeFillIns, scope: 'finals' });
  return {
    ...sc,
    agg: playerAgg(name, rows, { season: sc.season, includeFillIns }),
    regular,
    finals,
    ranks: playerRanks(name, rows, sc.season),
    sealed: sc.season !== undefined && isVotesSealed(sc.season),
    fillIns: includeFillIns
      ? undefined
      : {
          regular: fillInRecord(name, rows, sc.season, 'regular'),
          finals: fillInRecord(name, rows, sc.season, 'finals'),
        },
    // Votes are the one thing a career panel still drops: they were cast for
    // whichever team you turned out for that night.
    votes: {
      regular: includeFillIns
        ? playerAgg(name, rows, { season: sc.season, scope: 'regular' })
        : regular,
      finals: includeFillIns
        ? playerAgg(name, rows, { season: sc.season, scope: 'finals' })
        : finals,
      fillInRegular: fillInVotes(name, rows, sc.season, 'regular'),
      fillInFinals: fillInVotes(name, rows, sc.season, 'finals'),
    },
  };
});

/**
 * Per set leads: it's the view that compares players fairly, and the only one
 * the badges grade. The switch flips the whole panel, badges included.
 */
const MODES = [
  { key: 'rate', label: 'Per set' },
  { key: 'total', label: 'Totals' },
] as const;
const DEFAULT_MODE = MODES[0].key;
const trend = playerTrend(name, rows);

// Best/worst opponent (all meetings count, fill-ins included on both sides).
const h2h = bestWorstOpponent(name, rows);

// Match log (includes fill-in matches, flagged).
const log = playerRows(name, rows, { includeFillIns: true }).sort(
  (a, b) => a.season - b.season || a.round - b.round
);

// Match log display helpers. The Round column never needs more than two
// characters — a home-and-away round number, or the stage code for a final
// (`Final` is spelled out elsewhere, but not in a column this narrow).
const roundCell = (r: (typeof log)[number]) => r.stage ?? r.roundLabel;
// One set per line: it keeps the Result column narrow and makes a three-setter
// (finals, mostly) stand out at a glance.
const scoreLines = (r: (typeof log)[number]) =>
  r.score ? r.score.split(/\s+/) : [`${r.teamScore}–${r.opponentScore}`];
// The Final is the one match where the letter undersells the result: a win is a
// premiership, a loss is a runner-up. Every other round keeps its W/L.
const resultMark = (r: (typeof log)[number]) =>
  r.stage === 'F'
    ? { text: r.win ? '🏆' : '🥈', label: r.win ? 'Premiers' : 'Runners-up' }
    : { text: r.win ? 'W' : 'L', label: r.win ? 'Win' : 'Loss' };

const bio = bioHtml(slug);
const photos = playerPhotos(slug);
---
<Layout
  title={name}
  accent={{ color: accent.color, color2: accent.color2, ink: accent.ink }}
>
  <section class="section container player-head">
    <div class="head-avatar"><Avatar slug={slug} name={name} team={team} /></div>
    <div>
      <p class="eyebrow">Player Profile</p>
      <h1 class="serif-title" style="font-size:clamp(2rem,5vw,3rem)">{name}</h1>
      <div class="pill-row mt-8">
        <TeamChip team={team} />
        <span class="badge">{allTime.games} career matches</span>
        <span class="badge">{allTime.wins}W–{allTime.losses}L</span>
        {allTime.bog > 0 && <span class="badge badge--bog">{allTime.bog}× BOG</span>}
      </div>
    </div>
  </section>

  {photos.length > 0 && (
    <section class="section container">
      <div class="gallery">
        {photos.slice(0, 4).map((src) => <img src={src} alt={name} loading="lazy" />)}
      </div>
    </section>
  )}

  <section class="section container grid grid-2" style="align-items:start">
    <div>
      <p class="eyebrow">Bio</p>
      {bio ? (
        <div class="prose" set:html={bio} />
      ) : (
        <p class="muted">No bio written yet. Drop <code>{slug}.md</code> into <code>content/bios/</code>.</p>
      )}
    </div>
    <div>
      <p class="eyebrow">Per-season form</p>
      <h2 class="serif-title" style="margin-bottom:12px">Winners &amp; errors per set</h2>
      <TrendChart trend={trend} />
    </div>
  </section>

  <section class="section container">
    <div class="flex items-center gap-16 wrap" style="justify-content:space-between">
      <div>
        <p class="eyebrow">Career &amp; season splits</p>
        <h2 class="serif-title mb-0">Statistics</h2>
      </div>
      <div class="stat-controls">
        <div class="segmented" role="group" aria-label="Show totals or per-set rates">
          {MODES.map((m) => (
            <button type="button" class="seg" data-mode={m.key} aria-pressed={String(m.key === DEFAULT_MODE)}>
              {m.label}
            </button>
          ))}
        </div>
        <label class="season-select">
          <span class="sr-only">Filter by season</span>
          <select id="seasonFilter">
            <option value="all">All-time</option>
            {seasons.map((s) => <option value={String(s)}>{seasonLabel(s)}</option>)}
          </select>
        </label>
      </div>
    </div>

    {scopes.map((sc) =>
      MODES.map((m) => (
        <div
          class:list={['mt-16', 'stat-view', { hidden: !(sc.key === 'all' && m.key === DEFAULT_MODE) }]}
          data-scope={sc.key}
          data-mode={m.key}
        >
          <StatSummary
            agg={sc.agg}
            regular={sc.regular}
            finals={sc.finals}
            mode={m.key}
            ranks={sc.ranks[m.key]}
            scopeShort={sc.short}
            sealed={sc.sealed}
            season={sc.season}
            fillIns={sc.fillIns}
            votes={sc.votes}
          />
        </div>
      ))
    )}
    <VotesNote compact />
  </section>

  {h2h && (
    <section class="section container">
      <p class="eyebrow">Head to head</p>
      <h2 class="serif-title" style="margin-bottom:12px">Easiest &amp; Hardest Opponent</h2>
      <div class="grid grid-2 opp-grid">
        <OpponentTile label="Easiest" h2h={h2h.best} team={playerLatestTeam(h2h.best.opponent)} player={name} />
        <OpponentTile label="Hardest" h2h={h2h.worst} team={playerLatestTeam(h2h.worst.opponent)} player={name} />
      </div>
      <p class="finenote">
        Minimum {h2h.minMeetings} meetings. Fill-in appearances and finals both
        count. Hover or tap a tile for every meeting.
      </p>
    </section>
  )}

  <section class="section container" id="match-log">
    <p class="eyebrow">Every match</p>
    <h2 class="serif-title" style="margin-bottom:12px">Match Log</h2>
    <div class="card card--dark">
      <div class="table-wrap">
        <table class="stat matchlog">
          <thead>
            <tr>
              <th class="c-tight" title="Season">S</th>
              <th class="c-tight" title="Round">Rd</th>
              <th>Opponent</th><th class="c-res">Result</th>
              <th title="Winners">W</th><th title="Unforced errors">UE</th>
              <th title="Aces">Ace</th><th title="Double faults">DF</th>
              <th title="Errors forced (S2+)">EF</th>
              <th title="Votes — 3-2-1 from two voters in the home-and-away season, 4-3-2-1 in a final">V</th><th></th>
            </tr>
          </thead>
          <tbody>
            {log.map((r) => (
              <tr class={r.isFinals ? 'is-finals' : ''}>
                <td class="c-tight">{r.season}</td>
                <td class={`c-tight ${r.isFinals ? 'finals-rd' : ''}`}>{roundCell(r)}</td>
                <td class="c-opp">{r.opponent}</td>
                <td class="c-res">
                  <span class="res-cell">
                    <span
                      class={`res ${r.win ? 'win' : 'loss'} ${r.stage === 'F' ? 'res--medal' : ''}`}
                      title={resultMark(r).label}
                    >{resultMark(r).text}</span>
                    <span class="sets">
                      {scoreLines(r).map((s) => <span class="set"><SetScore score={s} /></span>)}
                    </span>
                  </span>
                </td>
                <td class="num">{r.winners ?? '—'}</td>
                <td>{r.unforcedErrors ?? '—'}</td>
                <td>{r.aces ?? '—'}</td>
                <td>{r.doubleFaults ?? '—'}</td>
                <td>{r.errorsForced ?? '—'}</td>
                <td>{r.votes ?? (isVotesSealed(r.season) ? '🔒' : '—')}</td>
                <td class="c-tags">
                  {r.bog && <span class="badge badge--bog">BOG</span>}
                  {r.isFillIn && <span class="badge badge--fill">Fill-in</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="mt-16"><a href={withBase('/players/')}>← All players</a></p>
  </section>
</Layout>

<script>
  // One panel per (season, mode) is pre-rendered; showing the right one is just
  // a matter of matching both.
  const sel = document.getElementById('seasonFilter') as HTMLSelectElement | null;
  const segs = [...document.querySelectorAll<HTMLButtonElement>('.seg')];
  const views = document.querySelectorAll<HTMLElement>('.stat-view');

  // Must match DEFAULT_MODE above — the pre-rendered panel starts here.
  let mode = 'rate';

  function show() {
    const scope = sel?.value ?? 'all';
    views.forEach((el) => {
      el.classList.toggle('hidden', el.dataset.scope !== scope || el.dataset.mode !== mode);
    });
    segs.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
  }

  sel?.addEventListener('change', show);
  segs.forEach((b) =>
    b.addEventListener('click', () => {
      mode = b.dataset.mode ?? 'total';
      show();
    })
  );
</script>

<style>
  .finals-rd { color: var(--gold-soft); font-weight: 600; letter-spacing: 0.04em; }

  /* Match log: tightened so the eleven columns read as one block rather than a
     sprawl. Season and Round are one/two characters, so they get no more room
     than that, and the scoreline stacks a set per line — which keeps Result
     narrow and makes a three-setter (a final, usually) obvious at a glance. */
  .matchlog { min-width: 460px; }
  .matchlog thead th, .matchlog tbody td { padding: 8px 7px; vertical-align: top; }
  .matchlog thead th:first-child, .matchlog tbody td:first-child { padding-left: 12px; }
  .matchlog thead th:last-child, .matchlog tbody td:last-child { padding-right: 12px; }
  .matchlog .c-tight, .matchlog thead th.c-tight { width: 1%; text-align: center; white-space: nowrap; }
  .matchlog .c-opp { text-align: left; white-space: nowrap; }
  /* Result reads W/L then the scoreline, on two fixed columns so both line up
     down the table whether the match went one set or three. The W/L used to be
     positioned out of flow, which left the cell free to be squeezed narrower
     than its scoreline — a tiebreak set then spilled sideways and printed on
     top of the W. In flow with a reserved sets column, it can't. */
  .matchlog td.c-res { white-space: nowrap; }
  .matchlog .res-cell { display: inline-grid; grid-template-columns: 1.1em auto; gap: 7px; align-items: start; }
  .matchlog .res { font-weight: 700; text-align: center; }
  /* A Final trades the letter for a trophy or a silver medal — colour glyphs, so
     the win/loss tint does nothing and the bold weight only smudges them. */
  .matchlog .res--medal { font-weight: 400; font-size: 0.95em; line-height: 1.2; }
  .matchlog .sets { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.35; min-width: 3.6em; }
  /* Every column hugs its content; the badge column soaks up the leftover
     width, so the data reads as one tight block instead of stretching to fill
     the card. */
  .matchlog .c-tags { width: 100%; text-align: left; white-space: nowrap; }
  .matchlog tbody tr.is-finals td { background: rgba(200, 162, 74, 0.06); }
  .matchlog tbody tr.is-finals:hover td { background: rgba(200, 162, 74, 0.1); }
  @media (max-width: 640px) {
    .matchlog thead th, .matchlog tbody td { padding: 8px 5px; }
  }
  .player-head { display: grid; grid-template-columns: 120px 1fr; gap: 20px; align-items: center; }
  .head-avatar { width: 120px; }
  @media (max-width: 520px) { .player-head { grid-template-columns: 84px 1fr; } .head-avatar { width: 84px; } }
  .gallery { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .gallery img { aspect-ratio: 3/4; object-fit: cover; border-radius: 10px; border: 1px solid var(--line); }
  @media (max-width: 640px) { .gallery { grid-template-columns: repeat(2, 1fr); } }
  /* Tiles sit on their own row so a popover can spill over the section below. */
  .opp-grid { align-items: start; gap: 14px; }
  .prose :global(p) { color: var(--ivory-dim); }
  .prose :global(a) { color: var(--gold-soft); }
  .stat-controls { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .segmented {
    display: inline-flex; border: 1px solid var(--line); border-radius: 999px;
    background: var(--card); padding: 3px;
  }
  .seg {
    font-family: var(--serif); font-size: 0.85rem; letter-spacing: 0.05em;
    color: var(--ivory-dim); background: none; border: 0; border-radius: 999px;
    padding: 6px 16px; cursor: pointer;
  }
  .seg[aria-pressed='true'] { background: var(--gold); color: #14140f; font-weight: 600; }
  .season-select select {
    font-family: var(--serif); font-size: 0.95rem; color: var(--ivory);
    background: var(--card); border: 1px solid var(--line); border-radius: 999px;
    padding: 8px 16px; letter-spacing: 0.05em;
  }
</style>
