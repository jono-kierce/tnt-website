---
import Layout from '../layouts/Layout.astro';
import VotesNote from '../components/VotesNote.astro';
import { SITE, seasonLabel, teamMeta, isVotesSealed } from '../config/site.ts';
import { withBase } from '../lib/url.ts';
import { allPlayers, allSeasons, perSet, playerAgg, COUNTING_STATS } from '../lib/stats.ts';
import { rows, playerLatestTeam } from '../lib/site-data.ts';

const seasons = allSeasons(rows);

/** Dominant team for a player within a scope (season or all-time). */
function scopeTeam(name: string, season?: number): string {
  if (season === undefined) return playerLatestTeam(name);
  const pr = rows.filter((r) => !r.isSingles && r.player === name && r.season === season);
  const counts = new Map<string, number>();
  for (const r of pr) counts.set(r.team, (counts.get(r.team) ?? 0) + 1);
  return [...counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] ?? '';
}

// Precompute per-player aggregates for every (season, fill-in mode).
//
// Each entry carries two numbers per stat, because the two boards answer
// different questions. `totals` is the home-and-away season: finals are played
// by eight teams out of nine, so whoever went deepest would top every counting
// board on volume alone. `rates` is per set across everything including finals,
// where the extra matches belong and the set denominator cancels out the fact
// that a semi runs to three.
const players = allPlayers(rows);
type Entry = {
  player: string; slug: string; team: string;
  games: number; gamesRegular: number; finalsGames: number;
  totals: Record<string, number | null>;
  rates: Record<string, number | null>;
  /** Matches behind each rate — a partial stat gets its own honest denominator. */
  coverage: Record<string, number>;
  bog: number; winPct: number; winnerToUe: number | null;
};
function buildScope(season: number | undefined, includeFillIns: boolean): Entry[] {
  return players
    .map((name) => {
      const all = playerAgg(name, rows, { season, includeFillIns });
      const reg = playerAgg(name, rows, { season, includeFillIns, scope: 'regular' });
      const fin = playerAgg(name, rows, { season, includeFillIns, scope: 'finals' });
      const totals: Record<string, number | null> = { bog: reg.bog };
      const rates: Record<string, number | null> = { bog: null };
      const coverage: Record<string, number> = { bog: reg.games };
      for (const stat of COUNTING_STATS) {
        totals[stat] = reg[stat];
        // Votes are awarded once per match however many sets it ran to.
        rates[stat] = stat === 'votes' ? all.votesPerGame : perSet(all, stat);
        coverage[stat] = all.tally[stat].games;
      }
      // The Finals MVP is its own award on its own scale (4-3-2-1), sharing the
      // votes column. A count over at most three matches, so it has no rate.
      totals.finalsVotes = fin.votes;
      return {
        player: name, slug: all.slug, team: scopeTeam(name, season),
        games: all.games, gamesRegular: reg.games, finalsGames: fin.games,
        totals, rates, coverage,
        bog: reg.bog, winPct: all.winPct,
        winnerToUe: all.winnerToUe === Infinity ? all.winners : all.winnerToUe,
      };
    })
    .filter((e) => e.games > 0);
}

const datasets: Record<string, Entry[]> = {};
for (const fill of [false, true]) {
  datasets[`all|${fill}`] = buildScope(undefined, fill);
  for (const s of seasons) datasets[`${s}|${fill}`] = buildScope(s, fill);
}

const teamColors: Record<string, { color: string; color2: string; ink: string }> = {};
for (const e of Object.values(datasets).flat()) {
  if (e.team && !teamColors[e.team]) {
    const m = teamMeta(e.team);
    teamColors[e.team] = { color: m.color, color2: m.color2, ink: m.ink };
  }
}

const sealedSeasons = seasons.filter(isVotesSealed);
const payload = { datasets, teamColors, minGames: SITE.perGameMinGames, sealedSeasons, playerBase: withBase('/players/') };
---
<Layout title="Leaderboards">
  <section class="section container">
    <p class="eyebrow">Who's really the best?</p>
    <h1 class="serif-title">Leaderboards</h1>
    <p class="lead" style="max-width:640px">
      Argue responsibly. Filter by season, flip between totals and per-set, and
      mind the minimum-matches threshold on rate boards. Totals are the
      home-and-away season; rates count finals, per set.
    </p>

    <div class="card controls">
      <label>Season
        <select id="lbSeason">
          <option value="all">All-time</option>
          {seasons.map((s) => <option value={String(s)}>{seasonLabel(s)}</option>)}
        </select>
      </label>
      <label>Stat
        <select id="lbStat">
          <option value="winners">Winners</option>
          <option value="unforcedErrors">Unforced Errors</option>
          <option value="aces">Aces</option>
          <option value="doubleFaults">Double Faults</option>
          <option value="errorsForced">Errors Forced (S2+)</option>
          <option value="votes">Votes (MVP)</option>
          <option value="finalsVotes">Finals MVP Votes</option>
          <option value="bog">Best on Ground</option>
          <option value="winPct">Win %</option>
          <option value="winnerToUe">Winner : UE ratio</option>
        </select>
      </label>
      <label>Mode
        <select id="lbMode">
          <option value="total">Totals</option>
          <option value="perSet">Per set</option>
        </select>
      </label>
      <label class="check"><input type="checkbox" id="lbFill" /> Include fill-in matches</label>
      <button class="btn btn--sm" id="lbCsv" type="button">Download table CSV</button>
    </div>
    <p class="finenote" id="lbNote"></p>

    <div class="card card--dark mt-16">
      <div class="table-wrap">
        <table class="stat" id="lbTable">
          <thead>
            <tr>
              <th class="col-rank">#</th>
              <th>Player</th>
              <th>Team</th>
              <th id="lbValHead">Value</th>
              <th>Matches</th>
            </tr>
          </thead>
          <tbody id="lbBody"></tbody>
        </table>
      </div>
    </div>

    <div class="mt-24"><VotesNote /></div>
  </section>
</Layout>

<script type="application/json" id="lbData" set:html={JSON.stringify(payload)}></script>
<script>
  type Entry = Record<string, number | string | null> & { player: string; slug: string; team: string; games: number };
  const cfg = JSON.parse(document.getElementById('lbData')!.textContent!);
  const $ = (id: string) => document.getElementById(id) as HTMLSelectElement & HTMLInputElement;
  const seasonSel = $('lbSeason'), statSel = $('lbStat'), modeSel = $('lbMode'), fillChk = $('lbFill');
  const body = document.getElementById('lbBody')!, note = document.getElementById('lbNote')!;
  const valHead = document.getElementById('lbValHead')!;

  const RATES_ONLY = ['winPct', 'winnerToUe']; // already rates
  // A count over at most three finals — a per-match rate would be noise.
  const TOTALS_ONLY = ['finalsVotes'];
  // Votes are awarded once a match, so their "rate" mode is per match, not per set.
  const PER_MATCH = ['votes'];
  const LABELS: Record<string, string> = {
    winners: 'Winners', unforcedErrors: 'Unforced Errors', aces: 'Aces',
    doubleFaults: 'Double Faults', errorsForced: 'Errors Forced', votes: 'Votes',
    finalsVotes: 'Finals MVP Votes',
    bog: 'Best on Ground', winPct: 'Win %', winnerToUe: 'Winner : UE',
  };

  let current: { rows: any[]; valLabel: string } = { rows: [], valLabel: '' };

  const ESCAPES: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' };
  const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ESCAPES[ch]);

  function metric(e: Entry, stat: string, perSet: boolean): number | null {
    if (stat === 'winPct') return e.winPct as number;
    if (stat === 'winnerToUe') return e.winnerToUe as number | null;
    return (perSet ? (e as any).rates : (e as any).totals)[stat] ?? null;
  }

  /** Matches behind the number shown — the rate's own coverage, or the H&A season. */
  function denom(e: Entry, stat: string, perSet: boolean): number {
    if (RATES_ONLY.includes(stat)) return e.games;
    // The Finals MVP board counts finals played, not home-and-away nights.
    if (stat === 'finalsVotes') return (e as any).finalsGames;
    return perSet ? ((e as any).coverage[stat] ?? 0) : (e as any).gamesRegular;
  }

  function fmt(v: number, stat: string, perSet: boolean): string {
    if (stat === 'winPct') return (v * 100).toFixed(0) + '%';
    if (perSet || stat === 'winnerToUe') return v.toFixed(2);
    return String(v);
  }

  function render() {
    const scope = seasonSel.value, stat = statSel.value;
    const perSet =
      modeSel.value === 'perSet' && !RATES_ONLY.includes(stat) && !TOTALS_ONLY.includes(stat);
    modeSel.disabled = RATES_ONLY.includes(stat) || TOTALS_ONLY.includes(stat);
    const data: Entry[] = cfg.datasets[`${scope}|${fillChk.checked}`] ?? [];

    let rows = data
      .map((e) => ({ e, value: metric(e, stat, perSet), games: denom(e, stat, perSet) }))
      .filter((r) => r.value !== null && r.games > 0) as
        { e: Entry; value: number; games: number }[];

    const minGames = cfg.minGames;
    const applyMin = perSet || RATES_ONLY.includes(stat);
    if (applyMin) rows = rows.filter((r) => r.games >= minGames);

    rows.sort((a, b) => b.value - a.value || b.games - a.games);

    // Votes are the one rate that isn't per set — they're awarded once a match.
    const rateLabel = perSet ? (PER_MATCH.includes(stat) ? ' / match' : ' / set') : '';
    valHead.textContent = LABELS[stat] + rateLabel;
    current = { rows: rows.map((r) => ({ ...r.e, value: r.value, games: r.games })), valLabel: LABELS[stat] + rateLabel };

    body.innerHTML = rows.map((r, i) => {
      const c = cfg.teamColors[r.e.team];
      const team = esc(r.e.team);
      // On a phone the name is hidden and the dot carries the team on its own,
      // so the label has to live on the dot itself.
      const chip = c
        ? `<span class="flex items-center gap-8" style="--team-color:${c.color};--team-color-2:${c.color2}"><span class="dot" role="img" title="${team}" aria-label="${team}"></span><span class="team-label">${team}</span></span>`
        : '';
      return `<tr>
        <td class="rank">${i + 1}</td>
        <td><a href="${cfg.playerBase}${r.e.slug}/">${esc(r.e.player)}</a></td>
        <td>${chip}</td>
        <td class="num">${fmt(r.value, stat, perSet)}</td>
        <td>${r.games}</td>
      </tr>`;
    }).join('') || `<tr><td colspan="5" class="muted">No qualifying players.</td></tr>`;

    const notes: string[] = ['All fill-in matches excluded' + (fillChk.checked ? ' — currently INCLUDED' : ' by default') + '.'];
    if (stat === 'finalsVotes') notes.push('The Finals MVP is voted 4-3-2-1 across the finals only. These votes never count toward the season MVP board.');
    else if (perSet && stat === 'votes') notes.push('Votes are awarded per match, so this rate stays per match.');
    else if (perSet) notes.push('Per-set rates include finals, normalised by sets played.');
    else if (!RATES_ONLY.includes(stat)) notes.push('Totals cover the home-and-away season — finals excluded, since only eight teams play them.');
    else notes.push('Win-loss counts finals.');
    if (stat === 'votes') notes.push('Season MVP votes only — finals votes are counted on their own board.');
    if (stat === 'votes' && scope === 'all') notes.push('Season 1 votes are era-adjusted to the two-voter 3-2-1 scale — a 2 counts as 6, a 1 as 4. Season boards show votes as cast.');
    notes.push('Matches shown is the number behind the figure — a stat missing from a night is left out, not counted as zero.');
    if (applyMin) notes.push(`Minimum ${minGames} matches to qualify.`);
    if ((stat === 'votes' || stat === 'finalsVotes') && cfg.sealedSeasons.includes(Number(scope))) notes.push('Votes for this season are sealed 🔒 — board will populate after awards night.');
    if (stat === 'errorsForced') notes.push('Errors Forced only tracked from Season 2.');
    note.textContent = notes.join(' ');
  }

  function downloadCsv() {
    const header = ['Rank', 'Player', 'Team', current.valLabel, 'Matches'];
    const lines = [header.join(',')].concat(
      current.rows.map((r, i) => [i + 1, `"${r.player}"`, r.team, r.value, r.games].join(','))
    );
    const blob = new Blob([lines.join('\n')], { type: 'text/csv' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `tnt-${statSel.value}-${seasonSel.value}.csv`;
    a.click();
    URL.revokeObjectURL(a.href);
  }

  [seasonSel, statSel, modeSel, fillChk].forEach((el) => el.addEventListener('change', render));
  document.getElementById('lbCsv')!.addEventListener('click', downloadCsv);
  render();
</script>

<style>
  .controls { display: flex; flex-wrap: wrap; gap: 14px 20px; align-items: center; }
  .controls label { font-family: var(--serif); letter-spacing: 0.06em; font-size: 0.82rem; color: var(--ivory-dim); display: flex; align-items: center; gap: 8px; }
  .controls select { font-family: var(--sans); font-size: 0.9rem; color: var(--ivory); background: var(--grass-800); border: 1px solid var(--line); border-radius: 8px; padding: 7px 10px; }
  .controls select:disabled { opacity: 0.4; }
  .controls .check { cursor: pointer; }
</style>
