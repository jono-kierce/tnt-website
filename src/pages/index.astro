---
import Layout from '../layouts/Layout.astro';
import LadderTable from '../components/LadderTable.astro';
import MatchCard from '../components/MatchCard.astro';
import { SITE, seasonLabel } from '../config/site.ts';
import { withBase, seasonHref, scheduleHref } from '../lib/url.ts';
import {
  headlineRound,
  rotatingFunStat,
  seasonLadder,
  seasonRosters,
} from '../lib/site-data.ts';

const season = SITE.currentSeason;
const table = seasonLadder(season);
const snapshot = table.slice(0, 8);
const fun = rotatingFunStat();

// The latest round with results, or — before a ball is hit — the first one
// drawn. There are no dates in the data, so "latest" means furthest through
// the fixture list, and the panel says which of the two it's showing.
const headline = headlineRound(season);
const pairings = Object.fromEntries(
  Object.entries(seasonRosters(season)).map(([team, r]) => [team, r.pairingName])
);
---
<Layout title="Home">
  <section class="section container hero">
    <p class="eyebrow">Melbourne · Social Doubles · Est. 2022</p>
    <h1 class="tabloid">Tuesday<br />Night Tennis</h1>
    <div class="pill-row mt-16">
      <a class="btn" href={scheduleHref()}>Schedule</a>
      <a class="btn" href={withBase('/ladder/')}>Current Ladder</a>
      <a class="btn" href={withBase('/leaderboards/')}>Leaderboards</a>
      <a class="btn" href={withBase('/records/')}>The Record Books</a>
    </div>
  </section>

  {fun && (
    <section class="section container">
      <div class="card funstat">
        <p class="eyebrow">{fun.kicker}</p>
        <h2 class="tabloid tabloid--accent" style="--team-color:var(--gold);--team-color-2:var(--gold-soft)">{fun.headline}</h2>
        <p class="lead mb-0" style="max-width:680px">{fun.detail}</p>
      </div>
    </section>
  )}

  <section class="section container">
    <div class="grid grid-2" style="align-items:start">
      <div>
        <p class="eyebrow">Standings</p>
        <h2 class="serif-title" style="margin-bottom:14px">{seasonLabel(season)} Ladder</h2>
        <LadderTable rows={snapshot} cutoff={8} caption="Ranked by wins, then games ratio (for ÷ against). Top 8 make finals." />
        <p class="mt-16"><a href={withBase('/ladder/')}>Full ladder →</a></p>
      </div>
      <div>
        <p class="eyebrow">{headline?.upcoming ? 'Next up' : 'Latest results'}</p>
        <h2 class="serif-title" style="margin-bottom:14px">
          {headline ? headline.heading : 'No matches yet'}
        </h2>
        {headline ? (
          <div class="results">
            {headline.round.matches.map((m) => (
              <MatchCard match={m} pairings={pairings} />
            ))}
          </div>
        ) : (
          <p class="muted">No {seasonLabel(season)} matches in the CSV yet.</p>
        )}
        {headline && headline.round.byes.length > 0 && (
          <p class="finenote">Bye: {headline.round.byes.join(', ')}.</p>
        )}
        <p class="mt-16">
          <a href={scheduleHref()}>Full schedule →</a>
          <span class="muted"> · </span>
          <a href={seasonHref(season)}>Season {season} in full →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section-lg container">
    <div class="grid grid-3">
      <a class="card nav-card" href={withBase('/players/')}>
        <p class="eyebrow">The Field</p><h3 class="serif-title">Players</h3>
        <p class="muted mb-0">Bios, galleries, career stat lines and season-by-season form.</p>
      </a>
      <a class="card nav-card" href={withBase('/records/')}>
        <p class="eyebrow">Hall of Fame &amp; Shame</p><h3 class="serif-title">Records</h3>
        <p class="muted mb-0">Most winners, most aces, biggest meltdowns and longest streaks.</p>
      </a>
      <a class="card nav-card" href={withBase('/seasons/')}>
        <p class="eyebrow">The Archive</p><h3 class="serif-title">Seasons</h3>
        <p class="muted mb-0">Final ladders, finals brackets, MVP podiums and honours.</p>
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-top: 40px; }
  .hero .tabloid { margin: 6px 0 18px; }
  .funstat { background: linear-gradient(135deg, #12271a, #0d0d0b); border-color: var(--line); }
  /* One card per match, stacked — they widen into two columns as soon as
     there's room, which on the home page's half-width column is most desktops. */
  .results { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; }
  .nav-card { transition: transform .15s ease, border-color .15s ease; }
  .nav-card:hover { transform: translateY(-3px); border-color: var(--gold); text-decoration: none; }
</style>
