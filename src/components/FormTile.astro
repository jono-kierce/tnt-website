---
import Avatar from './Avatar.astro';
import TeamChip from './TeamChip.astro';
import { matchHref, playerHref } from '../lib/url.ts';
import type { FormMatchup } from '../lib/stats.ts';

interface Props {
  /** Tile heading — "Best" or "Worst". */
  label: string;
  form: FormMatchup;
  /** Opponent's team, for the avatar colours. */
  team: string;
  /** Name of the player whose page this is (for the popover heading). */
  player: string;
}
const { label, form, team, player } = Astro.props;

/** Signed to one decimal, with a real minus sign rather than a hyphen. */
const signed = (n: number) => `${n >= 0 ? '+' : '−'}${Math.abs(n).toFixed(1)}`;

// A "best" match-up can still be a negative number — plenty of players simply
// have no opponent they lift against, and the tile says so rather than
// inventing a story. So the eyebrow is coloured by which tile it is, and the
// number by its own sign.
const up = form.delta >= 0;

// The justification line, direction-aware: the biggest mover is more often a
// DROP in unforced errors than a rise in winners, and "3.4 fewer than usual"
// has to read as the good news it is. A deviation that rounds to nothing is
// no reason at all, so the tile stays quiet instead of printing "0.0 more".
const r = form.reason && Math.abs(form.reason.delta) >= 0.05 ? form.reason : null;
const reason = r
  ? {
      text: `${r.value.toFixed(1)} ${r.label} a set — ${Math.abs(r.delta).toFixed(1)} ${
        r.delta > 0 ? 'more' : 'fewer'
      } than usual`,
      // Good news when a good stat went up or a bad one came down.
      better: r.delta > 0 !== r.bad,
    }
  : null;
---
<div class={`form-tile form-tile--${label.toLowerCase()}`} tabindex="0">
  <div class="form-face"><Avatar slug={form.slug} name={form.opponent} team={team} /></div>
  <div class="form-body">
    <div class="k">{label} form against</div>
    <a class="form-name serif-title" href={playerHref(form.slug)}>{form.opponent}</a>
    <div class={up ? 'v up' : 'v down'}>{signed(form.delta)}<span class="unit">/set</span></div>
    {reason ? (
      <div class={reason.better ? 'sub sub--good' : 'sub sub--bad'}>{reason.text}</div>
    ) : (
      <div class="sub">{form.meetings} statted meeting{form.meetings === 1 ? '' : 's'}</div>
    )}
  </div>

  <div class="form-pop" role="note">
    <p class="form-pop-head">
      {player} vs {form.opponent} — {form.meetings} statted meeting{form.meetings === 1 ? '' : 's'}
    </p>
    <ul class="form-pop-list">
      {form.games.map((g) => (
        <li>
          <a
            class={g.isFinals ? 'when when--finals' : 'when'}
            href={matchHref(g.season, g.round, g.stage, g.team, g.opponentTeam)}
          >
            S{g.season} {g.isFinals ? g.roundLabel : `R${g.roundLabel}`}
          </a>
          <span class="colours">
            <TeamChip team={g.team} plain />
            {g.fillIn && <span class="badge badge--fill">Fill-in</span>}
            <span class="v-sep">v</span>
            <TeamChip team={g.opponentTeam} plain />
          </span>
          <span class={g.perSet >= 0 ? 'net up' : 'net down'}>{signed(g.perSet)}</span>
        </li>
      ))}
    </ul>
    <p class="finenote" style="margin-top:6px">
      Winners, aces and errors forced, less unforced errors and double faults —
      per set, against the league average for that season. Their norm elsewhere
      is {signed(form.baseline)}.
    </p>
  </div>
</div>

<style>
  .form-tile {
    position: relative;
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 14px;
    align-items: center;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 16px;
  }
  .form-tile:hover, .form-tile:focus-visible, .form-tile:focus-within { border-color: var(--gold); }
  .form-tile:focus-visible { outline: none; }
  .form-face { width: 64px; }
  .form-body { min-width: 0; }
  .k {
    font-family: var(--serif); text-transform: uppercase; letter-spacing: 0.1em;
    font-size: 0.66rem; color: var(--muted);
  }
  .form-tile--best .k { color: var(--win); }
  .form-tile--worst .k { color: var(--loss); }
  .form-name {
    display: block; font-size: 1.05rem; color: var(--ivory);
    letter-spacing: 0.04em; overflow-wrap: anywhere;
  }
  .form-name:hover { color: var(--gold-soft); }
  .v { font-size: 1.7rem; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .v.up { color: var(--win); }
  .v.down { color: var(--loss); }
  .unit { font-size: 0.8rem; font-weight: 400; color: var(--muted); margin-left: 3px; }
  .sub { font-size: 0.72rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .sub--good { color: var(--win); }
  .sub--bad { color: var(--loss); }

  /* --- Hover / focus detail ------------------------------------------------ */
  .form-pop {
    position: absolute; z-index: 5; left: 0; right: 0; top: calc(100% + 8px);
    background: #0d0d0b; border: 1px solid var(--gold);
    border-radius: 12px; padding: 12px 14px; box-shadow: var(--shadow);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity 0.14s ease, transform 0.14s ease, visibility 0.14s;
  }
  .form-tile:hover .form-pop,
  .form-tile:focus .form-pop,
  .form-tile:focus-within .form-pop {
    opacity: 1; visibility: visible; transform: translateY(0);
  }
  .form-pop-head {
    font-family: var(--serif); text-transform: uppercase; letter-spacing: 0.1em;
    font-size: 0.66rem; color: var(--gold); margin: 0 0 8px;
  }
  .form-pop-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .form-pop-list li {
    display: grid; grid-template-columns: auto 1fr auto; gap: 10px;
    align-items: center; font-size: 0.8rem;
    border-top: 1px solid var(--line-soft); padding-top: 6px;
  }
  .form-pop-list li:first-child { border-top: 0; padding-top: 0; }
  .when { color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .when--finals { color: var(--gold-soft); }
  .colours {
    display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px;
    color: var(--ivory-dim);
  }
  .colours .badge { white-space: nowrap; }
  .v-sep { color: var(--muted); font-style: italic; }
  .net { font-variant-numeric: tabular-nums; font-weight: 600; }
  .net.up { color: var(--win); }
  .net.down { color: var(--loss); }

  @media (max-width: 560px) {
    .form-pop-list li { grid-template-columns: auto 1fr; row-gap: 2px; }
    .colours { grid-column: 2; }
    .form-pop-list li > :last-child { grid-column: 2; }
  }
</style>
