---
import type { FinalsRound, FinalsSlot, FinalsMatch } from '../config/seasons/schema.ts';
import type { LadderRow } from '../lib/types.ts';
import { teamMeta } from '../config/site.ts';

interface Props { finals: FinalsRound[]; ladder: LadderRow[] }
const { finals, ladder } = Astro.props;

// Resolve every match's winner/loser team so later rounds can reference them.
const winners = new Map<string, string>();
const losers = new Map<string, string>();
const allMatches = finals.flatMap((r) => r.matches);
const bySeed = (n: number) => ladder[n - 1]?.team ?? '';

function resolveTeam(slot: FinalsSlot): string {
  if ('seed' in slot) return bySeed(slot.seed);
  if ('winnerOf' in slot) return winners.get(slot.winnerOf) ?? '';
  return losers.get(slot.loserOf) ?? '';
}

// Two passes so winnerOf references resolve regardless of declaration order.
for (let pass = 0; pass < allMatches.length; pass++) {
  for (const m of allMatches) {
    if (!m.result || winners.has(m.id)) continue;
    const home = resolveTeam(m.home), away = resolveTeam(m.away);
    if (!home || !away) continue;
    winners.set(m.id, m.result.winner === 'home' ? home : away);
    losers.set(m.id, m.result.winner === 'home' ? away : home);
  }
}

function label(slot: FinalsSlot): string {
  if ('seed' in slot) {
    const l = ladder[slot.seed - 1];
    return l ? l.pairingName : `Seed ${slot.seed}`;
  }
  if ('winnerOf' in slot) {
    const t = winners.get(slot.winnerOf);
    return t ? (ladderName(t) ?? t) : `Winner of ${slot.winnerOf}`;
  }
  const t = losers.get(slot.loserOf);
  return t ? (ladderName(t) ?? t) : `Loser of ${slot.loserOf}`;
}
function ladderName(team: string) { return ladder.find((l) => l.team === team)?.pairingName; }
function slotTeam(slot: FinalsSlot): string { return resolveTeam(slot); }

// "6(4)" -> 6 games with the tiebreak points shown small, tennis-style.
function sets(scores: string[] | undefined) {
  return (scores ?? []).map((s) => {
    const m = /^(\d+)\((\d+)\)$/.exec(s.trim());
    return m ? { games: m[1], tb: m[2] } : { games: s, tb: null };
  });
}

// ---------------------------------------------------------------------------
// Bracket geometry. Ties are laid out on a grid so each match sits vertically
// centred between the two it feeds from — 1v8 above 4v5, their semi centred on
// the pair, and so on. Every leaf gets two grid rows so that a span's midpoint
// always lands exactly on a row line, which is what the connector lines hang
// off. Nothing here is season-specific; it's derived from the winnerOf/loserOf
// references, so any bracket shape lays itself out.
// ---------------------------------------------------------------------------
const byId = new Map(allMatches.map((m) => [m.id, m]));

function feeders(m: FinalsMatch): (FinalsMatch | undefined)[] {
  return [m.home, m.away].map((s) => {
    if ('winnerOf' in s) return byId.get(s.winnerOf);
    if ('loserOf' in s) return byId.get(s.loserOf);
    return undefined;
  });
}

/** Leaf-unit span [first, last] each match occupies, keyed by match id. */
const span = new Map<string, [number, number]>();
let leaves = 0;

function assign(m: FinalsMatch): [number, number] {
  const existing = span.get(m.id);
  if (existing) return existing;
  // Claim the id first so a malformed self/cyclic reference can't loop forever.
  span.set(m.id, [leaves, leaves]);
  const parts = feeders(m).map((f) => (f && f.id !== m.id ? assign(f) : ([leaves++, leaves - 1] as [number, number])));
  const s: [number, number] = [Math.min(...parts.map((p) => p[0])), Math.max(...parts.map((p) => p[1]))];
  span.set(m.id, s);
  return s;
}

// Walk back from the last round so the first round falls into bracket order.
for (const m of [...finals].reverse().flatMap((r) => r.matches)) assign(m);
const rows = Math.max(leaves, 1) * 2;

const rowStart = (m: FinalsMatch) => (span.get(m.id)?.[0] ?? 0) * 2 + 1;
const rowEnd = (m: FinalsMatch) => (span.get(m.id)?.[1] ?? 0) * 2 + 3;
/** Row line the tie's own centre sits on. */
const centreRow = (m: FinalsMatch) => {
  const s = span.get(m.id) ?? [0, 0];
  return s[0] + s[1] + 2;
};

/** Vertical line joining this match's two feeders, or null if it has none. */
function connector(m: FinalsMatch): [number, number] | null {
  const fed = feeders(m).filter((f): f is FinalsMatch => !!f);
  if (fed.length < 2) return null;
  const centres = fed.map(centreRow);
  return [Math.min(...centres), Math.max(...centres)];
}

// Render each round top-to-bottom in bracket order rather than declared order.
const orderedRounds = finals.map((r) => ({
  ...r,
  matches: [...r.matches].sort((a, b) => rowStart(a) - rowStart(b)),
}));
const lastRound = finals.length - 1;

function side(m: FinalsMatch, which: 'home' | 'away') {
  const slot = m[which];
  const team = slotTeam(slot);
  const meta = team ? teamMeta(team) : null;
  const won = m.result ? m.result.winner === which : false;
  const scores = m.result ? (which === 'home' ? m.result.homeScore : m.result.awayScore) : undefined;
  return { label: label(slot), team, meta, won, sets: sets(scores) };
}
---
{finals.length === 0 ? (
  <p class="muted">Finals bracket for this season hasn't been added yet.</p>
) : (
  <div class="bracket-wrap">
    <div class="bracket">
      {orderedRounds.map((round, ri) => (
        <div class="bracket-col">
          <div class="bracket-head">
            <p class="finenote bracket-round">{round.name}</p>
            {round.format && <p class="finenote bracket-format">{round.format}</p>}
          </div>
          <div class="bracket-ties" style={`grid-template-rows: repeat(${rows}, 1fr)`}>
          {round.matches.map((m) => connector(m)).map((c) => (
            c && <span class="connector" style={`grid-row: ${c[0]} / ${c[1]}`}></span>
          ))}
          {round.matches.map((m) => {
            const h = side(m, 'home'), a = side(m, 'away');
            return (
              <div class:list={['tie', 'card', { 'has-in': ri > 0, 'has-out': ri < lastRound }]}
                style={`grid-row: ${rowStart(m)} / ${rowEnd(m)}`}>
                {m.label && <span class="tie-label">{m.label}</span>}
                {[h, a].map((s) => (
                  <div class={`tie-side ${s.won ? 'won' : ''}`}
                    style={s.meta ? `--team-color:${s.meta.color};--team-color-2:${s.meta.color2}` : ''}>
                    <span class="bar"></span>
                    <span class="tie-name">{s.label}</span>
                    <span class="tie-score">
                      {s.sets.map((set) => (
                        <span class="set">{set.games}{set.tb && <sup>{set.tb}</sup>}</span>
                      ))}
                    </span>
                  </div>
                ))}
              </div>
            );
          })}
          </div>
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .bracket-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  /* --gap is split either side of the column boundary by the connector lines. */
  /* --line-soft reads as card borders but vanishes against the page, so the
     bracket lines get their own slightly brighter tone. */
  .bracket { display: flex; gap: var(--gap); min-width: min-content; align-items: stretch; --gap: 26px; --bracket-line: color-mix(in srgb, var(--muted) 42%, transparent); }
  .bracket-col { display: flex; flex-direction: column; min-width: 230px; }
  /* Explicit rows + spans put every tie on its feeders' midpoint. */
  .bracket-ties { flex: 1; display: grid; }
  .tie { align-self: center; margin: 5px 0; }
  .connector { justify-self: start; width: 1px; margin-left: calc(var(--gap) / -2); background: var(--bracket-line); }
  .tie.has-in::before, .tie.has-out::after {
    content: ''; position: absolute; top: 50%; width: calc(var(--gap) / 2); height: 1px; background: var(--bracket-line);
  }
  .tie.has-in::before { left: calc(var(--gap) / -2); }
  .tie.has-out::after { right: calc(var(--gap) / -2); }
  .bracket-round { text-align: center; text-transform: uppercase; letter-spacing: 0.16em; margin: 0; }
  .bracket-format { text-align: center; text-transform: none; letter-spacing: 0.02em; font-size: 0.68rem; opacity: 0.7; margin: 2px 0 2px; }
  .tie { padding: 10px 12px; position: relative; }
  .tie-label { position: absolute; top: -9px; left: 12px; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--muted); background: var(--card); padding: 0 6px; text-transform: uppercase; }
  .tie-side { display: grid; grid-template-columns: 6px 1fr auto; align-items: center; gap: 10px; padding: 8px 2px; }
  .tie-side + .tie-side { border-top: 1px solid var(--line-soft); }
  .tie-side .bar { height: 20px; }
  .tie-name { font-family: var(--serif); font-size: 0.98rem; white-space: nowrap; }
  .tie-side:not(.won) .tie-name { color: var(--ivory-dim); }
  .tie-side.won .tie-name { color: var(--ivory); font-weight: 700; }
  .tie-score { font-variant-numeric: tabular-nums; color: var(--gold-soft); font-weight: 700; display: flex; gap: 9px; }
  /* Fixed-width sets + out-of-flow tiebreak so both sides' columns line up. */
  .set { position: relative; min-width: 0.75em; text-align: right; }
  .set sup { position: absolute; left: 100%; top: -0.15em; font-size: 0.62em; font-weight: 600; }
</style>
