---
import type { FinalsRound, FinalsSlot, FinalsMatch } from '../config/seasons/schema.ts';
import type { LadderRow } from '../lib/types.ts';
import { teamMeta } from '../config/site.ts';
import { bracketLayout } from '../lib/bracket.ts';

interface Props { finals: FinalsRound[]; ladder: LadderRow[] }
const { finals, ladder } = Astro.props;

// Resolve every match's winner/loser team so later rounds can reference them.
const winners = new Map<string, string>();
const losers = new Map<string, string>();
const allMatches = finals.flatMap((r) => r.matches);
const bySeed = (n: number) => ladder[n - 1]?.team ?? '';

function resolveTeam(slot: FinalsSlot): string {
  if ('seed' in slot) return bySeed(slot.seed);
  if ('winnerOf' in slot) return winners.get(slot.winnerOf) ?? '';
  return losers.get(slot.loserOf) ?? '';
}

// One pass per match so winnerOf/loserOf references resolve regardless of
// declaration order.
for (let pass = 0; pass < allMatches.length; pass++) {
  for (const m of allMatches) {
    if (!m.result || winners.has(m.id)) continue;
    const home = resolveTeam(m.home), away = resolveTeam(m.away);
    if (!home || !away) continue;
    winners.set(m.id, m.result.winner === 'home' ? home : away);
    losers.set(m.id, m.result.winner === 'home' ? away : home);
  }
}

function label(slot: FinalsSlot): string {
  if ('seed' in slot) {
    const l = ladder[slot.seed - 1];
    return l ? l.pairingName : `Seed ${slot.seed}`;
  }
  if ('winnerOf' in slot) {
    const t = winners.get(slot.winnerOf);
    return t ? (ladderName(t) ?? t) : `Winner of ${slot.winnerOf}`;
  }
  const t = losers.get(slot.loserOf);
  return t ? (ladderName(t) ?? t) : `Loser of ${slot.loserOf}`;
}
function ladderName(team: string) { return ladder.find((l) => l.team === team)?.pairingName; }

// "6(4)" -> 6 games with the tiebreak points shown small, tennis-style.
function sets(scores: string[] | undefined) {
  return (scores ?? []).map((s) => {
    const m = /^(\d+)\((\d+)\)$/.exec(s.trim());
    return m ? { games: m[1], tb: m[2] } : { games: s, tb: null };
  });
}

function side(m: FinalsMatch, which: 'home' | 'away') {
  const slot = m[which];
  const team = resolveTeam(slot);
  const meta = team ? teamMeta(team) : null;
  const won = m.result ? m.result.winner === which : false;
  const scores = m.result ? (which === 'home' ? m.result.homeScore : m.result.awayScore) : undefined;
  return { label: label(slot), meta, won, sets: sets(scores) };
}

// ---------------------------------------------------------------------------
// Geometry. Where each tie sits and how its lines run comes from
// `src/lib/bracket.ts` in abstract units — the same layout the Instagram
// finals graphic draws — and these are this page's pixels for it. The tie's
// rows are a fixed height so a line can land on the row it fills: SLOT is the
// distance from a tie's centre to the middle of either row.
// ---------------------------------------------------------------------------
// Tie width: five rounds of 218 fit a 1280px window; a three-round knockout
// has the room to give a bold winner and a two-set score more.
const W = finals.length > 4 ? 218 : 250;
const G = 36;      // gap between rounds, where the lines turn
const U = 128;     // one unit down the page
const SLOT = 20.5; // .tie padding + border + half a 40px .tie-side
const PORT = 16;   // gap between a tie's two exits
const LANE = 10;   // gap between two lines turning in the same gap

const layout = bracketLayout(finals, { slot: SLOT / U, port: PORT / U });
const width = finals.length * W + Math.max(finals.length - 1, 0) * G;
const height = Math.ceil(layout.span * U);
const colX = (c: number) => c * (W + G);
const decided = new Set(allMatches.filter((m) => m.result).map((m) => m.id));

const paths = layout.edges.map((e) => {
  // Same round: a straight drop between the two ties' centres, drawn behind
  // them so only the gap between the cards shows.
  if (e.stacked) {
    const x = colX(e.toCol) + W / 2;
    return { d: `M${x} ${(e.y1 * U).toFixed(1)}V${(e.y2 * U).toFixed(1)}`, kind: e.kind, decided: decided.has(e.from) };
  }
  const x1 = colX(e.fromCol) + W;
  const x2 = colX(e.toCol);
  const y1 = +(e.y1 * U).toFixed(1);
  const y2 = +(e.y2 * U).toFixed(1);
  const turn = x2 - G / 2 + (e.lane - (e.lanes - 1) / 2) * LANE;
  const d = y1 === y2 ? `M${x1} ${y1}H${x2}` : `M${x1} ${y1}H${turn}V${y2}H${x2}`;
  return { d, kind: e.kind, decided: decided.has(e.from) };
});
---
{finals.length === 0 ? (
  <p class="muted">Finals bracket for this season hasn't been added yet.</p>
) : (
  <div class="bracket-wrap" style={`--bw:${width}px`}>
    <div class="bracket" style={`width:${width}px;--W:${W}px;--G:${G}px`}>
      <div class="bracket-heads">
        {finals.map((round) => (
          <div class="bracket-head">
            <p class="finenote bracket-round">{round.name}</p>
            {round.format && <p class="finenote bracket-format">{round.format}</p>}
          </div>
        ))}
      </div>
      <div class="bracket-field" style={`height:${height}px`}>
        <svg class="bracket-lines" width={width} height={height} viewBox={`0 0 ${width} ${height}`} aria-hidden="true">
          {paths.map((p) => <path d={p.d} class:list={[p.kind, { decided: p.decided }]} />)}
        </svg>
        {layout.columns.flatMap((col) => col.ties.map((t) => {
          const m = t.match;
          const h = side(m, 'home'), a = side(m, 'away');
          return (
            <div class:list={['tie', 'card', { double: t.doubleChance }]}
              style={`left:${colX(t.col)}px;top:${(t.pos * U).toFixed(1)}px`}>
              {m.label && <span class="tie-label">{m.label}</span>}
              {[h, a].map((s) => (
                <div class={`tie-side ${s.won ? 'won' : ''}`}
                  style={s.meta ? `--team-color:${s.meta.color};--team-color-2:${s.meta.color2}` : ''}>
                  <span class="bar"></span>
                  <span class="tie-name">{s.label}</span>
                  <span class="tie-score">
                    {s.sets.map((set) => (
                      <span class="set">{set.games}{set.tb && <sup>{set.tb}</sup>}</span>
                    ))}
                  </span>
                </div>
              ))}
            </div>
          );
        }))}
      </div>
    </div>
    {layout.doubleChance && (
      <p class="finenote bracket-key">
        <span class="key key-winner"></span> Winner through
        <span class="key key-loser"></span> Loser's second chance
        <span class="key key-double"></span> Double chance
      </p>
    )}
  </div>
)}

<style>
  /* A bracket wider than the page breaks out of the container, centred on it,
     up to the viewport's width; past that it scrolls. A narrower one stays
     flush left in the container like everything else on the page. */
  .bracket-wrap {
    --fit: max(100%, min(100vw - 40px, var(--bw)));
    width: var(--fit);
    margin-left: calc((100% - var(--fit)) / 2);
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    --bracket-line: color-mix(in srgb, var(--muted) 42%, transparent);
  }
  .bracket-heads { display: grid; grid-template-columns: repeat(auto-fill, var(--W)); column-gap: var(--G); margin-bottom: 12px; }
  .bracket-round { text-align: center; text-transform: uppercase; letter-spacing: 0.16em; margin: 0; }
  .bracket-format { text-align: center; text-transform: none; letter-spacing: 0.02em; font-size: 0.68rem; opacity: 0.7; margin: 2px 0 2px; }

  .bracket-field { position: relative; }
  .bracket-lines { position: absolute; inset: 0; overflow: visible; }
  .bracket-lines path { fill: none; stroke: var(--bracket-line); stroke-width: 1; }
  .bracket-lines path.loser { stroke: color-mix(in srgb, var(--loss) 70%, transparent); stroke-dasharray: 4 4; }
  .bracket-lines path.decided { stroke: color-mix(in srgb, var(--gold-soft) 60%, transparent); }
  .bracket-lines path.loser.decided { stroke: color-mix(in srgb, var(--loss) 85%, transparent); }

  /* Centred on its `top`, so the layout's `pos` is the tie's middle. */
  .tie { position: absolute; width: var(--W); transform: translateY(-50%); padding: 10px 12px; }
  .tie.double { border-color: color-mix(in srgb, var(--gold) 45%, var(--line)); }
  .tie-label { position: absolute; top: -9px; left: 12px; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--muted); background: var(--card); padding: 0 6px; text-transform: uppercase; white-space: nowrap; }
  .tie.double .tie-label { color: var(--gold-soft); }
  /* Fixed row height: the lines land on these rows (SLOT in the frontmatter). */
  .tie-side { display: grid; grid-template-columns: 6px 1fr auto; align-items: center; gap: 10px; height: 40px; padding: 0 2px; }
  .tie-side + .tie-side { border-top: 1px solid var(--line-soft); }
  .tie-side .bar { height: 20px; }
  /* A name too long for the row wraps onto a second line inside it rather than
     losing its tail — two lines still fit the fixed 40px. */
  .tie-name { font-family: var(--serif); font-size: 0.92rem; line-height: 1.05; }
  .tie-side:not(.won) .tie-name { color: var(--ivory-dim); }
  .tie-side.won .tie-name { color: var(--ivory); font-weight: 700; }
  .tie-score { font-variant-numeric: tabular-nums; color: var(--gold-soft); font-weight: 700; display: flex; gap: 9px; }
  /* Fixed-width sets + out-of-flow tiebreak so both sides' columns line up. */
  .set { position: relative; min-width: 0.75em; text-align: right; }
  .set sup { position: absolute; left: 100%; top: -0.15em; font-size: 0.62em; font-weight: 600; }

  .bracket-key { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 8px; margin: 18px 0 0; }
  .key { display: inline-block; width: 22px; height: 0; border-top: 1px solid var(--bracket-line); margin-left: 10px; }
  .key:first-child { margin-left: 0; }
  .key-loser { border-top: 1px dashed color-mix(in srgb, var(--loss) 70%, transparent); }
  .key-double { width: 14px; height: 10px; border: 1px solid color-mix(in srgb, var(--gold) 60%, var(--line)); border-radius: 3px; }
</style>
