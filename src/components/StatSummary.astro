---
import { isPartial, perSet, type CountingStat, type PlayerAgg } from '../lib/stats.ts';

interface Props {
  /** All matches, finals included — the source of every rate. */
  agg: PlayerAgg;
  /** Home-and-away only — the source of every raw total and the season record. */
  regular: PlayerAgg;
  /** Finals only — the September record, the Finals MVP and finals BOGs. */
  finals: PlayerAgg;
  scopeLabel: string;
  sealed?: boolean;
  season?: number;
}
const { agg, regular, finals, scopeLabel, sealed = false } = Astro.props;

const fmt = (n: number, d = 0) => n.toFixed(d);
const ratio =
  agg.winnerToUe === null ? '—'
  : agg.winnerToUe === Infinity ? '∞'
  : fmt(agg.winnerToUe, 2);

/** Totals come from the home-and-away season; a dash means never recorded. */
const total = (stat: CountingStat) => {
  const v = regular[stat] as number | null;
  return v === null ? '—' : String(v);
};

/**
 * Rates count finals too, normalised per set so a three-set final doesn't read
 * as a monster night. The sub-line owns up to any matches the stat is missing
 * from, so a partial total is never mistaken for a complete one.
 */
const rate = (stat: CountingStat) => {
  const v = perSet(agg, stat);
  if (v === null) return 'not recorded';
  const coverage = isPartial(agg, stat)
    ? ` · ${agg.tally[stat].games} of ${agg.games} matches`
    : '';
  return `${fmt(v, 2)} / set${coverage}`;
};

// Season MVP votes are a home-and-away award, so the total follows the same
// rule as the other totals — but the rate stays per match, not per set.
const votesDisplay = sealed && regular.votes === null ? '🔒' : regular.votes === null ? '—' : String(regular.votes);
const votesSub = sealed && regular.votes === null ? 'sealed until awards night'
  : regular.votesPerGame === null ? 'not recorded'
  : `${fmt(regular.votesPerGame, 2)} / match`;

// Finals MVP is voted 4-3-2-1, in the same column but never in the tally above.
const showFinalsVotes = finals.votes !== null || (sealed && finals.games > 0);
const finalsVotesDisplay = finals.votes === null ? '🔒' : String(finals.votes);
const finalsVotesSub =
  finals.votes === null ? 'sealed until awards night'
  : `4-3-2-1 · ${finals.games} finals`;
---
<div>
  <p class="finenote" style="margin:0 0 10px">{scopeLabel}</p>
  <div class="stat-tiles">
    <div class="tile"><div class="k">Matches</div><div class="v">{agg.games}</div>{agg.finalsGames > 0 && <div class="sub">{agg.finalsGames} finals · {agg.sets} sets</div>}</div>
    <div class="tile"><div class="k">Regular Season W–L</div><div class="v">{regular.wins}–{regular.losses}</div><div class="sub">{regular.games ? `${fmt(regular.winPct * 100, 0)}% win rate` : 'no home-and-away matches'}</div></div>
    {finals.games > 0 && (
      <div class="tile"><div class="k">Finals W–L</div><div class="v">{finals.wins}–{finals.losses}</div><div class="sub">{fmt(finals.winPct * 100, 0)}% win rate</div></div>
    )}
    <div class="tile"><div class="k">Winners</div><div class="v">{total('winners')}</div><div class="sub">{rate('winners')}</div></div>
    <div class="tile"><div class="k">Unforced Errors</div><div class="v">{total('unforcedErrors')}</div><div class="sub">{rate('unforcedErrors')}</div></div>
    <div class="tile"><div class="k">Winner : UE</div><div class="v">{ratio}</div><div class="sub">higher is cleaner</div></div>
    <div class="tile"><div class="k">Aces</div><div class="v">{total('aces')}</div></div>
    <div class="tile"><div class="k">Double Faults</div><div class="v">{total('doubleFaults')}</div></div>
    {agg.errorsForced !== null && (
      <div class="tile"><div class="k">Errors Forced</div><div class="v">{total('errorsForced')}</div><div class="sub">S2+ · {rate('errorsForced')}</div></div>
    )}
    <div class="tile"><div class="k">MVP Votes</div><div class="v">{votesDisplay}</div><div class="sub">{votesSub}</div></div>
    {showFinalsVotes && (
      <div class="tile"><div class="k">Finals MVP Votes</div><div class="v">{finalsVotesDisplay}</div><div class="sub">{finalsVotesSub}</div></div>
    )}
    <div class="tile"><div class="k">Best on Ground</div><div class="v">{agg.bog}</div>{finals.bog > 0 && <div class="sub">{finals.bog} in finals</div>}</div>
  </div>
  <p class="finenote" style="margin:10px 0 0">
    Totals cover the home-and-away season. Per-set rates include finals — a
    three-set final counts as three sets, not one big night. The Finals MVP is
    voted separately (4-3-2-1) and never counts toward MVP votes.
  </p>
</div>
