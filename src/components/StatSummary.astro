---
import RankChip from './RankChip.astro';
import { isPartial, perSet, type CountingStat, type PlayerAgg } from '../lib/stats.ts';
import type { RankBadge, RankMetric, RankMode } from '../lib/ranks.ts';
import { SITE } from '../config/site.ts';

interface Props {
  /** All matches, finals included — the source of every rate. */
  agg: PlayerAgg;
  /** Home-and-away only — the source of every raw total and the season record. */
  regular: PlayerAgg;
  /** Finals only — the September record, the Finals MVP and finals BOGs. */
  finals: PlayerAgg;
  /** Totals, or per set (per match for the awards). */
  mode: RankMode;
  /** Where this player sits in the field, for this scope and mode. */
  ranks: Partial<Record<RankMetric, RankBadge>>;
  /** Chip suffix: "all-time", "in S3". */
  scopeShort: string;
  sealed?: boolean;
  season?: number;
  /**
   * Fill-in appearances left out of this panel, split the way the two win-rate
   * tiles are. Season scopes only — a career panel counts them, so it passes
   * nothing.
   */
  fillIns?: {
    regular: { matches: number; wins: number; losses: number };
    finals: { matches: number; wins: number; losses: number };
  };
}
const { agg, regular, finals, mode, ranks, scopeShort, sealed = false, fillIns } = Astro.props;

const anyExcluded =
  fillIns !== undefined && fillIns.regular.matches + fillIns.finals.matches > 0;

const rateMode = mode === 'rate';
const fmt = (n: number, d = 0) => n.toFixed(d);
const num = (v: number | null, d = 0) => (v === null ? '—' : fmt(v, d));

/**
 * A counting stat's headline number: the home-and-away total, or its per-set
 * rate across everything including finals. Same split the leaderboards use.
 */
const value = (stat: CountingStat) =>
  rateMode ? num(perSet(agg, stat), 2) : num(regular[stat] as number | null);

/**
 * The sub-line owns up to any matches the stat is missing from, so a partial
 * total is never mistaken for a complete one.
 */
const coverage = (stat: CountingStat) =>
  isPartial(agg, stat) ? `${agg.tally[stat].games} of ${agg.games} matches` : '';

const sub = (stat: CountingStat, prefix = '') =>
  [prefix, rateMode ? 'per set' : '', coverage(stat)].filter(Boolean).join(' · ');

const ratio =
  agg.winnerToUe === null ? '—'
  : agg.winnerToUe === Infinity ? '∞'
  : fmt(agg.winnerToUe, 2);

// Season MVP votes are a home-and-away award; their rate is per match, since a
// vote is cast once a night however many sets it ran to.
const votesValue =
  sealed && regular.votes === null ? '🔒'
  : rateMode ? num(regular.votesPerGame, 2)
  : num(regular.votes);
const votesSub =
  sealed && regular.votes === null ? 'sealed until awards night'
  : rateMode ? 'per match'
  : '';

// The Finals MVP is voted 4-3-2-1, in the same column but never in the tally
// above. Too few matches behind it to be worth a rate.
const showFinalsVotes = finals.votes !== null || (sealed && finals.games > 0);
const finalsVotesSub =
  finals.votes === null ? 'sealed until awards night' : `4-3-2-1 · ${finals.games} finals`;

const bogValue = rateMode ? (agg.games ? fmt(agg.bog / agg.games, 2) : '—') : String(agg.bog);
const bogSub = [rateMode ? 'per match' : '', finals.bog > 0 ? `${finals.bog} in finals` : '']
  .filter(Boolean)
  .join(' · ');

const chip = (metric: RankMetric, what: string) => ({ badge: ranks[metric], what });
const ranked = Object.keys(ranks).length > 0;
---
<div>
  <div class="stat-tiles">
    <div class="tile">
      <div class="k">Matches</div>
      <div class="v">{agg.games}</div>
      <RankChip {...chip('games', 'matches played')} scopeShort={scopeShort} />
      {agg.finalsGames > 0 && <div class="sub">{agg.finalsGames} finals · {agg.sets} sets</div>}
    </div>

    {/* The badge grades the win rate, so the win rate is the headline and the
        record is the detail — the other way round invited the wrong reading. */}
    <div class="tile">
      <div class="k">Regular Season Win %</div>
      <div class="v">{regular.games ? `${fmt(regular.winPct * 100, 0)}%` : '—'}</div>
      <RankChip {...chip('winPct', 'home-and-away win rate')} scopeShort={scopeShort} />
      <div class="sub">
        {regular.games ? `${regular.wins}–${regular.losses}` : 'no home-and-away matches'}
      </div>
      {fillIns && fillIns.regular.matches > 0 && (
        <div class="sub sub--fine">
          Fill-ins excluded <span class="nowrap">({fillIns.regular.wins}–{fillIns.regular.losses})</span>
        </div>
      )}
    </div>

    {finals.games > 0 && (
      <div class="tile">
        <div class="k">Finals Win %</div>
        <div class="v">{fmt(finals.winPct * 100, 0)}%</div>
        <RankChip {...chip('finalsWinPct', 'finals win rate')} scopeShort={scopeShort} />
        <div class="sub">{finals.wins}–{finals.losses}</div>
        {fillIns && fillIns.finals.matches > 0 && (
          <div class="sub sub--fine">
            Fill-ins excluded <span class="nowrap">({fillIns.finals.wins}–{fillIns.finals.losses})</span>
          </div>
        )}
      </div>
    )}

    <div class="tile">
      <div class="k">Winners</div>
      <div class="v">{value('winners')}</div>
      <RankChip {...chip('winners', rateMode ? 'winners per set' : 'winners')} scopeShort={scopeShort} />
      {sub('winners') && <div class="sub">{sub('winners')}</div>}
    </div>

    <div class="tile">
      <div class="k">Unforced Errors</div>
      <div class="v">{value('unforcedErrors')}</div>
      <RankChip {...chip('unforcedErrors', rateMode ? 'unforced errors per set' : 'unforced errors')} scopeShort={scopeShort} />
      {sub('unforcedErrors') && <div class="sub">{sub('unforcedErrors')}</div>}
    </div>

    <div class="tile">
      <div class="k">Winner : UE</div>
      <div class="v">{ratio}</div>
      <RankChip {...chip('winnerToUe', 'winner-to-error ratio')} scopeShort={scopeShort} />
      <div class="sub">higher is cleaner</div>
    </div>

    <div class="tile">
      <div class="k">Aces</div>
      <div class="v">{value('aces')}</div>
      <RankChip {...chip('aces', rateMode ? 'aces per set' : 'aces')} scopeShort={scopeShort} />
      {sub('aces') && <div class="sub">{sub('aces')}</div>}
    </div>

    <div class="tile">
      <div class="k">Double Faults</div>
      <div class="v">{value('doubleFaults')}</div>
      <RankChip {...chip('doubleFaults', rateMode ? 'double faults per set' : 'double faults')} scopeShort={scopeShort} />
      {sub('doubleFaults') && <div class="sub">{sub('doubleFaults')}</div>}
    </div>

    {agg.errorsForced !== null && (
      <div class="tile">
        <div class="k">Errors Forced</div>
        <div class="v">{value('errorsForced')}</div>
        <RankChip {...chip('errorsForced', rateMode ? 'errors forced per set' : 'errors forced')} scopeShort={scopeShort} />
        <div class="sub">{sub('errorsForced', 'S2+')}</div>
      </div>
    )}

    <div class="tile">
      <div class="k">MVP Votes</div>
      <div class="v">{votesValue}</div>
      <RankChip {...chip('votes', rateMode ? 'votes per match' : 'MVP votes')} scopeShort={scopeShort} />
      {votesSub && <div class="sub">{votesSub}</div>}
    </div>

    {showFinalsVotes && (
      <div class="tile">
        <div class="k">Finals MVP Votes</div>
        <div class="v">{finals.votes === null ? '🔒' : finals.votes}</div>
        <RankChip {...chip('finalsVotes', 'Finals MVP votes')} scopeShort={scopeShort} />
        <div class="sub">{finalsVotesSub}</div>
      </div>
    )}

    <div class="tile">
      <div class="k">Best on Ground</div>
      <div class="v">{bogValue}</div>
      <RankChip {...chip('bog', rateMode ? 'BOGs per match' : 'Best on Ground')} scopeShort={scopeShort} />
      {bogSub && <div class="sub">{bogSub}</div>}
    </div>
  </div>

  <p class="finenote" style="margin:10px 0 0">
    {rateMode ? (
      <>
        Per-set rates count finals — a three-set final counts as three sets, not
        one big night. Votes and Best on Ground are awarded once a match, so
        they stay per match.
      </>
    ) : (
      <>
        Totals cover the home-and-away season, so a deep finals run can't pad
        them. Win–loss and the ratio count everything.
      </>
    )}
    {' '}
    {ranked ? (
      rateMode ? (
        <>
          Badges grade this player against everyone with {SITE.rankMinMatches}+ matches
          in this window — a short season swings a rate hard, so read a per-set rank
          with that in mind. Hover a badge for the rank and the size of the field.
        </>
      ) : (
        <>
          A total says as much about how many Tuesdays you've turned up to as how you
          played, so totals aren't graded — only a top-{SITE.rankTopTotals} finish in
          this window earns a badge. Hover it for the rank and the size of the field.
        </>
      )
    ) : (
      <>
        No badges: fewer than {SITE.rankMinMatches} matches in this window, which is
        too small a sample to rank{rateMode ? ' — especially per set' : ''}.
      </>
    )}
    The Finals MVP is voted separately (4-3-2-1) and never counts toward MVP votes.
    {fillIns === undefined && <>{' '}Fill-in appearances count toward these career numbers.</>}
    {anyExcluded && (
      <>
        {' '}A fill-in match was played for another team, so it sits outside this
        season — the tiles above show what was left out. It still counts all-time.
      </>
    )}
  </p>
</div>
